      "label": {
        "en": "Pre-heat lead time (minutes)",
        "fr": "Avance du préchauffage (minutes)",
        "de": "Vorlauf des Vorheizens (Minuten)",
        "es": "Antelación del precalentamiento (minutos)"
      },
      "description": {
        "en": "How long before a peak the pre-heat window opens. Hydro-Québec advises about two hours. 0 turns the pre-heat window off.",
        "fr": "Combien de temps avant une pointe s'ouvre la fenêtre de préchauffage. Hydro-Québec conseille environ deux heures. 0 désactive le préchauffage.",
        "de": "Wie lange vor einer Spitze sich das Vorheizfenster öffnet. Hydro-Québec empfiehlt etwa zwei Stunden. 0 schaltet das Vorheizen aus.",
        "es": "Cuánto tiempo antes de una punta se abre la ventana de precalentamiento. Hydro-Québec aconseja unas dos horas. 0 la desactiva."
      },
      "required": false,
      "default": 120,
      "min": 0,
      "max": 360
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the Hydro-Québec data is read again, in seconds. Peaks are published hours ahead: 15 minutes is plenty. The flags themselves change on the minute.",
        "fr": "Fréquence de relecture des données d'Hydro-Québec, en secondes. Les pointes sont publiées des heures à l'avance : 15 minutes suffisent. Les indicateurs, eux, changent à la minute près.",
        "de": "Wie oft die Daten von Hydro-Québec neu gelesen werden, in Sekunden. Spitzen werden Stunden im Voraus veröffentlicht: 15 Minuten genügen. Die Anzeigen selbst wechseln auf die Minute genau.",
        "es": "Cada cuánto se vuelven a leer los datos de Hydro-Québec, en segundos. Las puntas se publican con horas de antelación: 15 minutos bastan. Los indicadores cambian al minuto."
      },
      "required": false,
      "default": 900,
      "min": 300,
      "max": 3600
    }
